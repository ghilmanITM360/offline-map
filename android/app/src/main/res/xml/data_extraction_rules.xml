<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules. See #58: the app's single AsyncStorage
  database (RKStorage) holds lastKnownLocation (real device coordinates — wrong to
  restore onto a different device) and the unfinished-journey marker (a destination id
  that means nothing on another device) alongside favorites/settings. Because Android backup exclusion is
  file-granular, not per-key, excluding the shared DB is the only way to keep the
  sensitive/device-specific fields out of backups today.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="RKStorage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="RKStorage" />
    </device-transfer>
</data-extraction-rules>
