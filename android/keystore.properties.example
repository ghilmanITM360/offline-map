# Template for android/keystore.properties (gitignored — never commit real values here).
#
# 1. Generate a production keystore yourself (do NOT commit the resulting file):
#      keytool -genkeypair -v -keystore release.keystore -alias karachi-ijtema-release \
#        -keyalg RSA -keysize 2048 -validity 10000
#    Place the generated release.keystore under android/app/ (or another gitignored path),
#    and choose your own strong store/key passwords when prompted.
#
# 2. Copy this file to android/keystore.properties and fill in the real values below.
#    storeFile is resolved relative to android/app/.
#
# 3. Alternatively, skip this file entirely and set these as environment variables instead:
#      ANDROID_RELEASE_STORE_FILE, ANDROID_RELEASE_STORE_PASSWORD,
#      ANDROID_RELEASE_KEY_ALIAS, ANDROID_RELEASE_KEY_PASSWORD
#
# See docs/SECURITY_AUDIT.md (C3) for full context.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
