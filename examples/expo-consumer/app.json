{
  "expo": {
    "name": "SDK Consumer",
    "slug": "sdk-expo-consumer",
    "version": "0.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.example.sdkconsumer"
    },
    "android": {
      "package": "com.example.sdkconsumer",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "@muslim-ummah/offline-navigation",
        {
          "locationPermissionText": "The SDK consumer uses your location only while the app is open, to follow your progress along a route.",
          "languages": [
            "en",
            "ur"
          ]
        }
      ]
    ],
    "userInterfaceStyle": "automatic"
  }
}
